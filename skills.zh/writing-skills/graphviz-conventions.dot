digraph STYLE_GUIDE {
    // 我们流程 DSL 的风格指南，本身也是用这个 DSL 写的

    // 节点类型示例及其形状
    subgraph cluster_node_types {
        label="节点类型与形状";

        // 问题用菱形
        "这是一个问题吗？" [shape=diamond];

        // 动作用方框（默认）
        "执行一个动作" [shape=box];

        // 命令用纯文本
        "git commit -m 'msg'" [shape=plaintext];

        // 状态用椭圆
        "当前状态" [shape=ellipse];

        // 警告用八边形
        "停止：关键警告" [shape=octagon, style=filled, fillcolor=red, fontcolor=white];

        // 入口/出口用双圆
        "流程开始" [shape=doublecircle];
        "流程完成" [shape=doublecircle];

        // 每种形状的示例
        "测试通过了吗？" [shape=diamond];
        "先写测试" [shape=box];
        "npm test" [shape=plaintext];
        "我卡住了" [shape=ellipse];
        "绝不要使用 git add -A" [shape=octagon, style=filled, fillcolor=red, fontcolor=white];
    }

    // 边的命名约定
    subgraph cluster_edge_types {
        label="边标签";

        "二选一决策？" [shape=diamond];
        "yes 路径" [shape=box];
        "no 路径" [shape=box];

        "二选一决策？" -> "yes 路径" [label="yes"];
        "二选一决策？" -> "no 路径" [label="no"];

        "多选决策？" [shape=diamond];
        "选项 A" [shape=box];
        "选项 B" [shape=box];
        "选项 C" [shape=box];

        "多选决策？" -> "选项 A" [label="条件 A"];
        "多选决策？" -> "选项 B" [label="条件 B"];
        "多选决策？" -> "选项 C" [label="否则"];

        "流程 A 完成" [shape=doublecircle];
        "流程 B 开始" [shape=doublecircle];

        "流程 A 完成" -> "流程 B 开始" [label="触发", style=dotted];
    }

    // 命名模式
    subgraph cluster_naming_patterns {
        label="命名模式";

        // 问题以 ? 结尾
        "我应该做 X 吗？";
        "这能是 Y 吗？";
        "Z 为真吗？";
        "我已经完成 W 了吗？";

        // 动作以动词开头
        "写测试";
        "搜索模式";
        "提交更改";
        "请求帮助";

        // 命令保留字面形式
        "grep -r 'pattern' .";
        "git status";
        "npm run build";

        // 状态描述情况
        "测试失败了";
        "构建完成";
        "卡在错误上";
    }

    // 流程结构模板
    subgraph cluster_structure {
        label="流程结构模板";

        "触发：某事发生" [shape=ellipse];
        "初始检查？" [shape=diamond];
        "主要动作" [shape=box];
        "git status" [shape=plaintext];
        "还有一个检查？" [shape=diamond];
        "替代动作" [shape=box];
        "停止：不要这样做" [shape=octagon, style=filled, fillcolor=red, fontcolor=white];
        "流程完成" [shape=doublecircle];

        "触发：某事发生" -> "初始检查？";
        "初始检查？" -> "主要动作" [label="yes"];
        "初始检查？" -> "替代动作" [label="no"];
        "主要动作" -> "git status";
        "git status" -> "还有一个检查？";
        "还有一个检查？" -> "流程完成" [label="ok"];
        "还有一个检查？" -> "停止：不要这样做" [label="problem"];
        "替代动作" -> "流程完成";
    }

    // 何时使用哪种形状
    subgraph cluster_shape_rules {
        label="何时使用每种形状";

        "选择形状" [shape=ellipse];

        "这是决策吗？" [shape=diamond];
        "用菱形" [shape=diamond, style=filled, fillcolor=lightblue];

        "这是命令吗？" [shape=diamond];
        "用纯文本" [shape=plaintext, style=filled, fillcolor=lightgray];

        "这是警告吗？" [shape=diamond];
        "用八边形" [shape=octagon, style=filled, fillcolor=pink];

        "这是入口/出口吗？" [shape=diamond];
        "用双圆" [shape=doublecircle, style=filled, fillcolor=lightgreen];

        "这是状态吗？" [shape=diamond];
        "用椭圆" [shape=ellipse, style=filled, fillcolor=lightyellow];

        "默认：用方框" [shape=box, style=filled, fillcolor=lightcyan];

        "选择形状" -> "这是决策吗？";
        "这是决策吗？" -> "用菱形" [label="yes"];
        "这是决策吗？" -> "这是命令吗？" [label="no"];
        "这是命令吗？" -> "用纯文本" [label="yes"];
        "这是命令吗？" -> "这是警告吗？" [label="no"];
        "这是警告吗？" -> "用八边形" [label="yes"];
        "这是警告吗？" -> "这是入口/出口吗？" [label="no"];
        "这是入口/出口吗？" -> "用双圆" [label="yes"];
        "这是入口/出口吗？" -> "这是状态吗？" [label="no"];
        "这是状态吗？" -> "用椭圆" [label="yes"];
        "这是状态吗？" -> "默认：用方框" [label="no"];
    }

    // 好例子 vs 坏例子
    subgraph cluster_examples {
        label="好例子与坏例子";

        // 好例子：具体且形状正确
        "测试失败" [shape=ellipse];
        "阅读错误信息" [shape=box];
        "能复现吗？" [shape=diamond];
        "git diff HEAD~1" [shape=plaintext];
        "绝不要忽略错误" [shape=octagon, style=filled, fillcolor=red, fontcolor=white];

        "测试失败" -> "阅读错误信息";
        "阅读错误信息" -> "能复现吗？";
        "能复现吗？" -> "git diff HEAD~1" [label="yes"];

        // 坏例子：模糊且形状错误
        bad_1 [label="情况不对", shape=box];  // 应该用椭圆（状态）
        bad_2 [label="修复它", shape=box];  // 太模糊
        bad_3 [label="检查", shape=box];  // 应该用菱形
        bad_4 [label="运行命令", shape=box];  // 应该用纯文本并写出具体命令

        bad_1 -> bad_2;
        bad_2 -> bad_3;
        bad_3 -> bad_4;
    }
}
